nora/train.py --- Python
  1 from __future__ import annotations
  2 
  3 import json
  4 from functools import partial
  5 from pathlib import Path
  6 from typing import Any
  7 
  8 import fire
  9 from pytorch_lightning import Trainer, seed_everything
 10 from pytorch_lightning.loggers import CSVLogger
 11 from torch.optim import AdamW
 12 
 13 from chytorch.zoo.rxnmap import Model
 14 from nora.datasets import (
 15     GoldenDataset,
 16     MetamdbDataset,
 17     RingReactionsDataset,
 18     Schneider50kDataset,
 19     print_dataset_stats,
 20 )
 21 
 22 
 23 def write_json(path: Path | str, payload: dict[str, Any]) -> str:
 24     output = Path(path)
 25     output.parent.mkdir(parents=True, exist_ok=True)
 26     output.write_text(json.dumps(payload, indent=2, sort_keys=True))
 27     return str(output)
 28 
 29 
 30 def build_model(mode: str, masking_rate: float, learning_rate: float, dropout: float) -> Model:
 31     model_kwargs = {
 32         "masking_rate": masking_rate,
 33         "optimizer": partial(AdamW, lr=learning_rate),
 34         "dropout": dropout,
 35     }
 36     if mode == "pretrained":
 37         return Model.pretrained(**model_kwargs)
 38     if mode == "scratch":
 39         return Model(**model_kwargs)
 40     raise ValueError("mode must be 'scratch' or 'pretrained'")
 41 
 42 
 43 def run_training(
 44     *,
 45     dataset: str,
 46     train_split: str,
 47     test_split: str,
 48     train_csv: str | None,
 49     test_csv: str | None,
 50     data_root: str | None,
 51     batch_size: int,
 52     max_epochs: int,
 53     seed: int,
 54     mode: str,
 55     masking_rate: float,
 56     learning_rate: float,
 57     dropout: float,
 58     output_json: str,
 59 ) -> dict[str, Any]:
 60     if dataset.lower() == "ringreactions":
 61         train_dataset = RingReactionsDataset(
 62             split=train_split,
 63             csv_path=train_csv or "train_ringreactions.csv",
 64             root=data_root,
 65         )
 66         test_dataset = RingReactionsDataset(
 67             split=test_split,
 68             csv_path=test_csv or "test_ringreactions.csv",
 69             root=data_root,
 70         )
 71     else:
 72         dataset_key = dataset.lower()
 73         if dataset_key in {"schneider50k", "uspto50k"}:
 74             train_dataset = Schneider50kDataset(split=train_split, root=data_root)
 75             test_dataset = Schneider50kDataset(split=test_split, root=data_root)
 76         elif dataset_key == "metamdb":
 77             train_dataset = MetamdbDataset(split=train_split, root=data_root)
 78             test_dataset = MetamdbDataset(split=test_split, root=data_root)
 79         elif dataset_key == "golden":
 80             train_dataset = GoldenDataset(split=train_split, root=data_root)
 81             test_dataset = GoldenDataset(split=test_split, root=data_root)
 82         else:
 83             raise ValueError(
 84                 "Unknown dataset. Use ringreactions, schneider50k/uspto50k, metamdb, or golden."
 85             )
 86 
 87     print_dataset_stats(train_dataset)
 88     print_dataset_stats(test_dataset)
 89     if len(train_dataset.packed) == 0:
 90         raise RuntimeError("No valid reactions available in the training dataset.")
 91 
 92     seed_everything(seed, workers=True)
 93     model = build_model(mode, masking_rate, learning_rate, dropout)
 94     train_loader = model.prepare_dataloader(
 95         train_dataset.packed,
 96         batch_size=batch_size,
 97         shuffle=True,
 98         num_workers=4,
 99         pin_memory=False,
100         persistent_workers=False,
101     )
102 
103     logger = CSVLogger("lightning_logs", name=f"rxnmap_{mode}")
104     trainer = Trainer(
105         max_epochs=max_epochs,
106         logger=logger,
107         callbacks=model.configure_callbacks(),
108         log_every_n_steps=10,
109         num_sanity_val_steps=0,
110     )
111 
112     trainer.fit(model, train_dataloaders=train_loader)
113 
114     log_dir = Path(logger.log_dir)
115     checkpoint_dir = log_dir / "checkpoints"
116     checkpoint_dir.mkdir(parents=True, exist_ok=True)
117     last_checkpoint = checkpoint_dir / "last.ckpt"
118     trainer.save_checkpoint(str(last_checkpoint))
119 
120     results: dict[str, Any] = {
121         "dataset": dataset,
122         "train_split": train_split,
123         "test_split": test_split,
124         "seed": seed,
125         "batch_size": batch_size,
126         "max_epochs": max_epochs,
127         "mode": mode,
128         "masking_rate": masking_rate,
129         "learning_rate": learning_rate,
130         "dropout": dropout,
131         "log_dir": str(log_dir),
132         "last_checkpoint": str(last_checkpoint),
133         "train_dataset": train_dataset.stats,
134         "test_dataset": test_dataset.stats,
135     }
136     results["summary_json"] = write_json(output_json, results)
137     return results
138 
139 
140 def main(
141     dataset: str = "ringreactions",
142     train_split: str = "train",
143     test_split: str = "test",
144     train_csv: str | None = None,
145     test_csv: str | None = None,
146     data_root: str | None = None,
147     batch_size: int = 16,
148     max_epochs: int = 1,
149     seed: int = 42,
150     mode: str = "scratch",
151     masking_rate: float = 0.15,
152     learning_rate: float = 1e-4,
153     dropout: float = 0.1,
154     output_json: str = "experiment_results/nora_main_summary.json",
155 ) -> dict[str, Any]:
156     """Train the rxnmap model with the same minimal flow shown in the README."""
157     return run_training(
158         dataset=dataset,
159         train_split=train_split,
160         test_split=test_split,
161         train_csv=train_csv,
162         test_csv=test_csv,
163         data_root=data_root,
164         batch_size=batch_size,
165         max_epochs=max_epochs,
166         seed=seed,
167         mode=mode,
168         masking_rate=masking_rate,
169         learning_rate=learning_rate,
170         dropout=dropout,
171         output_json=output_json,
172     )
173 
174 
175 if __name__ == "__main__":
176     fire.Fire(main)
177 

setup.py --- Python
 1 #!/usr/bin/env python3
