nora/datasets.py --- Python
  1 from __future__ import annotations
  2 
  3 import csv
  4 from pathlib import Path
  5 from typing import Any, Iterable
  6 
  7 from chython import smiles
  8 
  9 
 10 def _resolve_path(*, root: str | Path | None, path: str | Path) -> Path:
 11     candidate = Path(path)
 12     if candidate.is_absolute() or root is None:
 13         return candidate
 14     return Path(root) / candidate
 15 
 16 
 17 def _read_lines(path: Path) -> list[str]:
 18     with path.open("r") as handle:
 19         return [line.strip() for line in handle if line.strip()]
 20 
 21 
 22 def _read_csv_column(
 23     path: Path,
 24     *,
 25     delimiter: str = ",",
 26     column_index: int = 0,
 27 ) -> list[str]:
 28     with path.open("r", newline="") as handle:
 29         rows = []
 30         for row in csv.reader(handle, delimiter=delimiter):
 31             if not row or len(row) <= column_index:
 32                 continue
 33             value = row[column_index].strip()
 34             if value:
 35                 rows.append(value)
 36         return rows
 37 
 38 
 39 def _read_tsv_column(path: Path, column: str) -> list[str]:
 40     with path.open("r", newline="") as handle:
 41         reader = csv.DictReader(handle, delimiter="\t")
 42         rows = []
 43         for row in reader:
 44             value = row.get(column, "").strip()
 45             if value:
 46                 rows.append(value)
 47         return rows
 48 
 49 
 50 def _split_rows(
 51     rows: list[str],
 52     *,
 53     split: str,
 54     train_ratio: float = 0.8,
 55     val_ratio: float = 0.1,
 56 ) -> list[str]:
 57     if split not in {"train", "val", "test"}:
 58         raise ValueError(f"split must be 'train', 'val', or 'test', got '{split}'")
 59     if not rows:
 60         return []
 61     train_end = int(len(rows) * train_ratio)
 62     val_end = int(len(rows) * (train_ratio + val_ratio))
 63     if split == "train":
 64         return rows[:train_end]
 65     if split == "val":
 66         return rows[train_end:val_end]
 67     return rows[val_end:]
 68 
 69 
 70 def _parse_reactions(rows: Iterable[str], source: Path) -> tuple[list[Any], list[bytes], int, int]:
 71     reactions: list[Any] = []
 72     packed: list[bytes] = []
 73     total = 0
 74     failed = 0
 75     warning_count = 0
 76 
 77     for row in rows:
 78         reaction_smiles = row.strip()
 79         if not reaction_smiles:
 80             continue
 81         total += 1
 82         try:
 83             reaction = smiles(reaction_smiles)
 84             reaction.canonicalize()
 85             reactions.append(reaction)
 86             packed.append(reaction.pack())
 87         except Exception as exc:
 88             failed += 1
 89             if warning_count < 10:
 90                 print(f"Warning: failed to parse reaction #{total} from {source}: {exc}")
 91                 warning_count += 1
 92 
 93     return reactions, packed, total, failed
 94 
 95 
 96 class ReactionDatasetBase:
 97     def __init__(self, dataset_name: str, source: Path, split: str, rows: Iterable[str]):
 98         self.dataset_name = dataset_name
 99         self.source = source
100         self.split = split
101         self._reactions: list[Any] = []
102         self._packed: list[bytes] = []
103         self._total = 0
104         self._failed = 0
105         self._reactions, self._packed, self._total, self._failed = _parse_reactions(rows, source)
106 
107     @property
108     def reactions(self) -> list[Any]:
109         return self._reactions
110 
111     @property
112     def packed(self) -> list[bytes]:
113         return self._packed
114 
115     @property
116     def stats(self) -> dict[str, Any]:
117         return {
118             "total": self._total,
119             "valid": len(self._packed),
120             "failed": self._failed,
121             "split": self.split,
122             "source": str(self.source),
123         }
124 
125     def __len__(self) -> int:
126         return len(self._packed)
127 
128     def __repr__(self) -> str:
129         return (
130             f"{self.__class__.__name__}('{self.dataset_name}', "
131             f"split='{self.split}', total={self._total}, valid={len(self._packed)}, failed={self._failed})"
132         )
133 
134 
135 class GoldenDataset(ReactionDatasetBase):
136     DEFAULT_SMILES_PATH = Path("golden.smiles")
137 
138     def __init__(
139         self,
140         *,
141         split: str = "train",
142         smiles_path: str | Path | None = None,
143         root: str | Path | None = None,
144     ):
145         if split not in {"train", "val", "test"}:
146             raise ValueError(f"golden split must be 'train', 'val', or 'test', got '{split}'")
147         resolved_path = _resolve_path(root=root, path=smiles_path or self.DEFAULT_SMILES_PATH)
148         if not resolved_path.exists():
149             raise FileNotFoundError(f"Golden file not found: {resolved_path}")
150         rows = _split_rows(_read_lines(resolved_path), split=split)
151         super().__init__(dataset_name="golden", source=resolved_path, split=split, rows=rows)
152 
153 
154 class Schneider50kDataset(ReactionDatasetBase):
155     DEFAULT_TSV_PATH = Path("schneider50k.tsv")
156     COLUMN = "clean_rxn"
157 
158     def __init__(
159         self,
160         *,
161         split: str = "train",
162         tsv_path: str | Path | None = None,
163         root: str | Path | None = None,
164     ):
165         if split not in {"train", "val", "test"}:
166             raise ValueError(f"schneider50k split must be 'train', 'val', or 'test', got '{split}'")
167         resolved_path = _resolve_path(root=root, path=tsv_path or self.DEFAULT_TSV_PATH)
168         if not resolved_path.exists():
169             raise FileNotFoundError(f"Schneider file not found: {resolved_path}")
170         rows = _split_rows(_read_tsv_column(resolved_path, self.COLUMN), split=split)
171         super().__init__(dataset_name="schneider50k", source=resolved_path, split=split, rows=rows)
