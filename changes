200 class MetamdbDataset(ReactionDatasetBase):
201     TRAIN_PATH = Path("train_metamdb_filtered.csv")
202     TEST_PATH = Path("test_metamdb_filtered.csv")
203     DELIMITER = ";"
204 
205     def __init__(
206         self,
207         *,
208         split: str = "train",
209         csv_path: str | Path | None = None,
210         root: str | Path | None = None,
211     ):
212         if split not in {"train", "val", "test"}:
213             raise ValueError(f"metamdb split must be 'train', 'val', or 'test', got '{split}'")
214         if split == "test":
215             resolved_path = _resolve_path(root=root, path=csv_path or self.TEST_PATH)
216             if not resolved_path.exists():
217                 raise FileNotFoundError(f"MetaDB file not found: {resolved_path}")
218             rows = _read_csv_column(resolved_path, delimiter=self.DELIMITER, column_index=1)
219         else:
220             resolved_path = _resolve_path(root=root, path=csv_path or self.TRAIN_PATH)
221             if not resolved_path.exists():
222                 raise FileNotFoundError(f"MetaDB file not found: {resolved_path}")
223             rows = _split_rows(
224                 _read_csv_column(resolved_path, delimiter=self.DELIMITER, column_index=1),
225                 split=split,
226                 train_ratio=0.9,
227                 val_ratio=0.1,
228             )
229         super().__init__(dataset_name="metamdb", source=resolved_path, split=split, rows=rows)
