174 class RingReactionsDataset(ReactionDatasetBase):
175     TRAIN_PATH = Path("train_ringreactions.csv")
176     TEST_PATH = Path("test_ringreactions.csv")
177 
178     def __init__(
179         self,
180         *,
181         split: str = "train",
182         csv_path: str | Path | None = None,
183         root: str | Path | None = None,
184     ):
185         if split not in {"train", "val", "test"}:
186             raise ValueError(f"ringreactions split must be 'train', 'val', or 'test', got '{split}'")
187         if split == "test":
188             resolved_path = _resolve_path(root=root, path=csv_path or self.TEST_PATH)
189             if not resolved_path.exists():
190                 raise FileNotFoundError(f"Ring reactions file not found: {resolved_path}")
191             rows = _read_csv_column(resolved_path)
192         else:
193             resolved_path = _resolve_path(root=root, path=csv_path or self.TRAIN_PATH)
194             if not resolved_path.exists():
195                 raise FileNotFoundError(f"Ring reactions file not found: {resolved_path}")
196             rows = _split_rows(_read_csv_column(resolved_path), split=split, train_ratio=0.9, val_ratio=0.1)
197         super().__init__(dataset_name="ringreactions", source=resolved_path, split=split, rows=rows)
198 
