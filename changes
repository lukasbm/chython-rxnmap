237 class CombinedReactionDataset:
238     """Combines multiple datasets into one in-memory dataset."""
239 
240     def __init__(self, *datasets: ReactionDatasetBase, name: str | None = None):
241         self.dataset_name = name or "+".join(dataset.dataset_name for dataset in datasets)
242         self.split = "combined"
243         self._reactions: list[Any] = [reaction for dataset in datasets for reaction in dataset.reactions]
244         self._packed: list[bytes] = [packed for dataset in datasets for packed in dataset.packed]
245         self._total: int = sum(dataset._total for dataset in datasets)
246         self._failed: int = sum(dataset._failed for dataset in datasets)
247 
248     @property
249     def reactions(self) -> list[Any]:
250         return self._reactions
251 
252     @property
253     def packed(self) -> list[bytes]:
254         return self._packed
255 
256     @property
257     def stats(self) -> dict[str, Any]:
258         return {
259             "total": self._total,
260             "valid": len(self._packed),
261             "failed": self._failed,
262             "split": self.split,
263         }
264 
265     def __len__(self) -> int:
266         return len(self._packed)
267 
268     def __repr__(self) -> str:
269         return (
270             f"CombinedReactionDataset('{self.dataset_name}', "
271             f"n={len(self._packed)}, total={self._total}, failed={self._failed})"
272         )
